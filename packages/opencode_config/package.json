{
  "name": "@pwarnock/opencode_config",
  "version": "0.1.0",
  "description": "OpenCode configuration package for liaison-toolkit",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format esm && tsc --emitDeclarationOnly --outDir dist && mkdir -p dist/schemas && cp ../agent_primitives/dist/schemas/*.json dist/schemas/",
    "dev": "bun --watch src/index.ts",
    "type-check": "tsc --noEmit",
    "test": "bun run test:ts",
    "test:ts": "echo '✓ TypeScript tests: passed (no test files)'",
    "test:python": "uv run pytest tests/ -v --cov=. --cov-report=term-missing",
    "test:all": "bun run test && bun run test:python",
    "lint": "eslint src --ext .ts",
    "setup": "bun src/scripts/setup.ts",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "opencode",
    "ai",
    "agents",
    "configuration"
  ],
  "author": "Patrick Warnock",
  "license": "MIT",
  "dependencies": {
    "@pwarnock/agent_primitives": "^0.1.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@types/node": "^25.0.2",
    "typescript": "^5.0.0",
    "bun-types": "latest",
    "eslint": "^8.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./templates": "./templates/",
    "./scripts": "./src/scripts/",
    "./schemas/mcp-servers": {
      "import": "./dist/schemas/mcp-servers.json"
    },
    "./schemas/skill-config": {
      "import": "./dist/schemas/skill-config.json"
    }
  },
  "files": [
    "dist",
    "templates",
    "src/scripts"
  ]
}